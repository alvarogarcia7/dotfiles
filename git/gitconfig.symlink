[core]
	excludesFile = ~/.gitignore
	autocrlf = input
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/SourceTree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[user]
	name = \"Alvaro Garcia\"
  email = alvarogarcia7@users.noreply.github.com
  # see file ~/.extra

[alias]
	commitatdate = !bash commitatdate.sh 
	c = !git commitatdate -m 
	ca = !git commitatdate --amend --reset-author -m 
	cc = !git commitatdate --all -m 
	s = status
	aa = add --all
	a = add
	g = log --pretty --graph --oneline
	l = log -n1
	d = diff --color-words
	dl=log -n1 -p
	b=branch -l | grep "*" | awk '{print $2}'
	logauthors=log --format="%aN %aE %cN %cE"
	workwith=!cat ~/bin/pair_with.sh
	unchanged=update-index --assume-unchanged 
	no-unchanged=update-index --no-assume-unchanged 
#problem: adds two times the parameter
#	i = !echo "$@" >> .gitignore
	p = pull --rebase --prune --autostash
  pruneold = !git branch -r | awk '{print $1}' | egrep -v -f /dev/fd/0 < $(git branch -vv | grep origin) | awk '{print $1}' | xargs git branch -d 
	pruneoldforce = !git branch -r | awk '{print $1}' | egrep -v -f /dev/fd/0 <(git branch -vv | grep origin) | awk '{print $1}' | xargs git branch -D
[push]
	default = simple
  autoSetupRemote = true
[gui]
	editor = vim
[branch]
	autosetuprebase = always
[mergetool "diffmerge"]
  #cmd = /Users/alvaro/bin/diff-wrapper.sh
  cmd = "$HOME/bin/diff-wrapper.sh \"$LOCAL\" \"$REMOTE\""

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = master
[fetch]
	pruneTags = true
[receive]
	denyCurrentBranch = updateInstead

# 2026-06-01 18:56:34 AGB
# From https://blog.gitbutler.com/how-git-core-devs-configure-git
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[init]
  defaultBranch = main
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[fetch]
  prune = true
  pruneTags = true
  all = true

# why the hell not?

[help]
  autocorrect = prompt

[pull]
  rebase = true

[rerere]
  enabled = true
  autoUpdate = true

[rebase]
#      autoSquash = true
  autoStash = true

[merge]
# zdiff3 adds original text markers and removes matching lines from conflict regions
# https://git-scm.com/docs/git-config#Documentation/git-config.txt-mergeconflictStyle
  conflictStyle = zdiff3
  autoStash = true

